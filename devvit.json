{
  "$schema": "https://developers.reddit.com/schema/config-file.v1.json",
  "name": "keymoderator",
  "permissions": {
    "reddit": {
      "enable": true,
      "scope": "moderator",
      "asUser": ["SUBMIT_POST"]
    },
    "redis": true
  },
  "post": {
    "dir": "dist/client",
    "entrypoints": {
      "default": {
        "entry": "launch.html",
        "height": "tall",
        "inline": true
      },
      "workspace": {
        "entry": "index.html"
      }
    }
  },
  "server": {
    "dir": "dist/server",
    "entry": "index.cjs"
  },
  "menu": {
    "items": [
      {
        "label": "Open KeyModerator",
        "location": "subreddit",
        "forUserType": "moderator",
        "endpoint": "/internal/menu/open-keyqueue"
      }
    ]
  },
  "settings": {
    "subreddit": {
      "removal_reason_1": { "type": "paragraph", "label": "Removal reason 1", "defaultValue": "" },
      "removal_reason_2": { "type": "paragraph", "label": "Removal reason 2", "defaultValue": "" },
      "removal_reason_3": { "type": "paragraph", "label": "Removal reason 3", "defaultValue": "" },
      "removal_reason_4": { "type": "paragraph", "label": "Removal reason 4", "defaultValue": "" },
      "removal_reason_5": { "type": "paragraph", "label": "Removal reason 5", "defaultValue": "" },
      "removal_reason_6": { "type": "paragraph", "label": "Removal reason 6", "defaultValue": "" },
      "removal_reason_7": { "type": "paragraph", "label": "Removal reason 7", "defaultValue": "" },
      "removal_reason_8": { "type": "paragraph", "label": "Removal reason 8", "defaultValue": "" },
      "removal_reason_9": { "type": "paragraph", "label": "Removal reason 9", "defaultValue": "" },
      "removal_reason_flair_1": { "type": "string", "label": "Removal reason 1 flair ID", "defaultValue": "" },
      "removal_reason_flair_2": { "type": "string", "label": "Removal reason 2 flair ID", "defaultValue": "" },
      "removal_reason_flair_3": { "type": "string", "label": "Removal reason 3 flair ID", "defaultValue": "" },
      "removal_reason_flair_4": { "type": "string", "label": "Removal reason 4 flair ID", "defaultValue": "" },
      "removal_reason_flair_5": { "type": "string", "label": "Removal reason 5 flair ID", "defaultValue": "" },
      "removal_reason_flair_6": { "type": "string", "label": "Removal reason 6 flair ID", "defaultValue": "" },
      "removal_reason_flair_7": { "type": "string", "label": "Removal reason 7 flair ID", "defaultValue": "" },
      "removal_reason_flair_8": { "type": "string", "label": "Removal reason 8 flair ID", "defaultValue": "" },
      "removal_reason_flair_9": { "type": "string", "label": "Removal reason 9 flair ID", "defaultValue": "" },
      "key_approve": { "type": "string", "label": "Key binding: approve", "defaultValue": "s" },
      "key_ban": { "type": "string", "label": "Key binding: ban", "defaultValue": "b" },
      "key_lock": { "type": "string", "label": "Key binding: lock", "defaultValue": "l" },
      "key_flair": { "type": "string", "label": "Key binding: flair", "defaultValue": "f" },
      "key_note": { "type": "string", "label": "Key binding: note", "defaultValue": "m" },
      "key_user": { "type": "string", "label": "Key binding: user", "defaultValue": "u" },
      "key_next": { "type": "string", "label": "Key binding: next", "defaultValue": "j" },
      "key_prev": { "type": "string", "label": "Key binding: prev", "defaultValue": "k" },
      "key_select": { "type": "string", "label": "Key binding: select", "defaultValue": " " },
      "key_undo": { "type": "string", "label": "Key binding: undo", "defaultValue": "Backspace" },
      "key_help": { "type": "string", "label": "Key binding: help", "defaultValue": "?" },
      "key_spam": { "type": "string", "label": "Key binding: mark spam", "defaultValue": "x" },
      "key_view": { "type": "string", "label": "Key binding: view on Reddit", "defaultValue": "o" },
      "key_nsfw": { "type": "string", "label": "Key binding: toggle NSFW", "defaultValue": "n" },
      "key_spoiler": { "type": "string", "label": "Key binding: toggle spoiler", "defaultValue": "e" },
      "key_sticky": { "type": "string", "label": "Key binding: toggle highlight/sticky", "defaultValue": "t" },
      "key_distinguish": { "type": "string", "label": "Key binding: distinguish", "defaultValue": "d" },
      "key_ignore_reports": { "type": "string", "label": "Key binding: ignore reports", "defaultValue": "i" },
      "key_refresh": { "type": "string", "label": "Key binding: refresh queue", "defaultValue": "r" },
      "key_select_all": { "type": "string", "label": "Key binding: select all", "defaultValue": "a" },
      "key_mute": { "type": "string", "label": "Key binding: mute author", "defaultValue": "Shift+m" }
    }
  },
  "scheduler": {
    "tasks": {
      "finalize_removal": "/internal/scheduler/finalize-removal"
    }
  },
  "triggers": {
    "onAppUpgrade": "/internal/triggers/repair-host-fallback",
    "onAutomoderatorFilterPost": "/internal/triggers/automod-filter",
    "onAutomoderatorFilterComment": "/internal/triggers/automod-filter"
  },
  "scripts": {
    "build": "npm run build",
    "dev": "vite build --config vite.devvit.config.ts --watch"
  },
  "dev": {
    "subreddit": "ARSPharma"
  }
}
